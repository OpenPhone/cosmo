    "stringStorage": {
      "2d13a1cb09f08b0fa816437718003adc0413e98b": "schema {subscription: Subscription} type Subscription {employeeUpdated(employeeID: Int!): Employee! filteredEmployeeUpdated(employeeID: ID!): Employee!} type Employee {id: Int! details: Details fieldThrowsError: String} type Details {forename: String! surname: String!}"
